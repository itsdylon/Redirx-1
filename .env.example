# ===========================================
# Redirx - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single root .env is used by the backend (Flask API + Worker).
# Frontend env vars live in frontend/.env (VITE_* prefix).
# Required frontend analytics vars:
#   - VITE_PUBLIC_POSTHOG_KEY
#   - VITE_PUBLIC_POSTHOG_HOST
#
# DEPLOYMENT NOTE:
#   On Render, set these as env vars on each service separately.
#   See the tables below for which vars each service needs.
#
# ┌─────────────────────────────────┬─────────┬────────┐
# │ Variable                        │ API     │ Worker │
# ├─────────────────────────────────┼─────────┼────────┤
# │ SUPABASE_URL                    │ ✓ req   │ ✓ req  │
# │ SUPABASE_KEY                    │ ✓ req   │ ✓ req  │
# │ DATABASE_URL                    │         │ ✓ req  │
# │ OPENAI_API_KEY                  │         │ ✓ req  │
# │ RESEND_API_KEY                  │ ✓ req   │ ✓ req  │
# │ APP_BASE_URL                    │ ✓ req   │ ✓ req  │
# │ STRIPE_SECRET_KEY               │ ✓ req   │ ✓ req  │
# │ STRIPE_WEBHOOK_SECRET           │ ✓ req   │        │
# │ STRIPE_PRICE_ID_*  (all 3)     │ ✓ req   │ ✓ req  │
# │ CORS_ORIGINS                    │ ✓ req   │        │
# │ FLASK_ENV / FLASK_DEBUG         │ optional│        │
# │ WORKER_*  (4 vars)             │         │ optional│
# │ SCRAPER_MAX_CONCURRENT_*        │         │ optional│
# │ SITE_AUDITOR_*                  │ optional│        │
# └─────────────────────────────────┴─────────┴────────┘

# --- Supabase (required: API + Worker) ---
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" key for the backend (NOT the anon key)
SUPABASE_KEY=your-service-role-key-here

# --- PostgreSQL Direct Connection (required: Worker only) ---
# Get from: Supabase Dashboard → Connect → Direct connection or Session Mode
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# IMPORTANT: Must use Direct or Session Mode (NOT Transaction Mode) for LISTEN/NOTIFY
DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres

# --- OpenAI (required: Worker only) ---
# Get from: https://platform.openai.com/api-keys
# Used by the pipeline for generating embeddings. Not needed by the API.
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Embedding Config (optional: Worker only, defaults shown) ---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# --- Matching Thresholds (optional: Worker only, defaults shown) ---
# HIGH_CONFIDENCE_THRESHOLD=0.85
# MEDIUM_CONFIDENCE_THRESHOLD=0.7
# AMBIGUITY_GAP_THRESHOLD=0.1

# --- Content Job URL Caps (optional: API + Worker, defaults shown) ---
# Hard caps are enforced before queueing and again in the worker fail-fast path.
# CONTENT_MAX_URLS_PER_SITE=5000
# CONTENT_MAX_OLD_URLS=5000
# CONTENT_MAX_NEW_URLS=5000

# --- Deep Match Preview Funnel (optional: API + Worker, defaults shown) ---
# ENABLE_DEEP_MATCH_PREVIEW=false
# PREVIEW_MAX_OLD_CANDIDATES=12
# PREVIEW_MAX_NEW_URLS_FULL_SCAN=300
# PREVIEW_MAX_NEW_URLS_CAPPED=180
# PREVIEW_FREE_ROWS=2
# PREVIEW_MAX_JOBS_PER_USER_PER_DAY=2
# DEEP_MATCH_BACKGROUND_MIN_PAGES=50

# --- Worker Configuration (optional: Worker only, defaults shown) ---
# WORKER_LEASE_DURATION=600       # Lease timeout in seconds (default: 10 min)
# WORKER_MAX_CONCURRENT=1         # Max concurrent jobs (default: 1)
# WORKER_FALLBACK_INTERVAL=60     # Fallback poll interval in seconds
# WORKER_MAX_ATTEMPTS=5           # Max retries before permanent failure
# SCRAPER_MAX_CONCURRENT_TOTAL=12      # Per-job total scrape fanout (bounded 1-64)
# SCRAPER_MAX_CONCURRENT_PER_SITE=8    # Per old/new site scrape fanout (bounded 1-32)

# --- Demo Site Auditor (optional: API only, defaults shown) ---
# SITE_AUDITOR_MAX_URLS=50                 # Max discovered URLs to audit (bounded 1-200)
# SITE_AUDITOR_SCRAPE_MAX_CONCURRENT=10    # Concurrent page scrapes per audit (bounded 1-30)

# --- Stripe (required: API + Worker) ---
# Get from: https://dashboard.stripe.com/apikeys
# API uses checkout/webhooks; worker uses usage metering for agency overages.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Webhook secret for verifying Stripe webhook signatures.
# For LOCAL DEV: Run `stripe listen` once, copy the whsec_... secret it prints.
#   dev.py will auto-start `stripe listen --forward-to localhost:5001/api/billing/webhook`.
# For PRODUCTION: Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Price IDs (required: API + Worker)
# Create products in Stripe Dashboard, then copy price IDs here.
STRIPE_PRICE_ID_AGENCY_MONTHLY=price_xxx
STRIPE_PRICE_ID_AGENCY_ANNUAL=price_xxx
STRIPE_PRICE_ID_AGENCY_OVERAGE=price_xxx

# Stripe Meter event name (required for agency overage billing)
# Create a Billing Meter in Stripe Dashboard, then copy the event name here.
STRIPE_METER_EVENT_NAME=

# --- Email / Resend (required: API + Worker) ---
# Get from: https://resend.com/api-keys
# Domain redirx.dev is verified on Resend.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=Dylon @ RedirX <noreply@redirx.dev>
# Base URL for links in emails (dashboard, unsubscribe, etc.)
APP_BASE_URL=http://localhost:3000

# --- Local Dev Settings (API only) ---
# CORS: set to * for local dev. In production (Render), set to your frontend URL.
CORS_ORIGINS=*
FLASK_ENV=development
FLASK_DEBUG=1
