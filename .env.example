# ===========================================
# Redirx - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single root .env is used by the backend (Flask + Worker).
# Frontend env vars live in frontend/.env (VITE_* prefix).

# --- Supabase (required) ---
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" key for the backend (NOT the anon key)
SUPABASE_KEY=your-service-role-key-here

# --- PostgreSQL Direct Connection (required for worker) ---
# Get from: Supabase Dashboard → Connect → Direct connection or Session Mode
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# IMPORTANT: Must use Direct or Session Mode (NOT Transaction Mode) for LISTEN/NOTIFY
DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres

# --- OpenAI (required for embeddings) ---
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.002 per 200 webpages
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Embedding Config (optional, defaults shown) ---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# --- Matching Thresholds (optional, defaults shown) ---
# HIGH_CONFIDENCE_THRESHOLD=0.85
# MEDIUM_CONFIDENCE_THRESHOLD=0.7
# AMBIGUITY_GAP_THRESHOLD=0.1

# --- Worker Configuration (optional, defaults shown) ---
# WORKER_LEASE_DURATION=600  # 10 minutes
# WORKER_MAX_CONCURRENT=1    # Process one session at a time
# WORKER_FALLBACK_INTERVAL=60  # Fallback poll every 60 seconds
# WORKER_MAX_ATTEMPTS=5      # Max retries before permanent failure

# --- Stripe (required for billing) ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Webhook secret for verifying Stripe webhook signatures.
# For LOCAL DEV: Run `stripe listen` once, copy the whsec_... secret it prints.
#   dev.py will auto-start `stripe listen --forward-to localhost:5001/api/billing/webhook`.
# For PRODUCTION: Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Price IDs (create products in Stripe Dashboard, then copy price IDs)
STRIPE_PRICE_ID_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_ID_STARTER_ANNUAL=price_xxx
STRIPE_PRICE_ID_GROWTH_MONTHLY=price_xxx
STRIPE_PRICE_ID_GROWTH_ANNUAL=price_xxx
STRIPE_PRICE_ID_SCALE_MONTHLY=price_xxx
STRIPE_PRICE_ID_SCALE_ANNUAL=price_xxx
STRIPE_PRICE_ID_FOUNDER=price_xxx
STRIPE_PRICE_ID_CREDITS=price_xxx

# --- Local Dev Settings ---
# CORS: set to * for local dev. In production (Render), set to your frontend URL.
CORS_ORIGINS=*
FLASK_ENV=development
FLASK_DEBUG=1
