# ===========================================
# Redirx Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only VITE_* vars are needed here (embedded at build time by Vite).
# Backend env vars live in the root .env file.

# Supabase (client-side auth)
# Get from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "anon public" key here (safe for client-side)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# OAuth callback is computed at runtime as:
#   ${window.location.origin}/auth/callback
# Ensure this URL is allow-listed in Supabase Authentication → URL Configuration.

# Backend API URL
# Leave UNSET for local dev (Vite proxy handles it automatically).
# Only set in production (e.g., https://your-api.onrender.com)
# VITE_API_BASE_URL=https://your-api.onrender.com
