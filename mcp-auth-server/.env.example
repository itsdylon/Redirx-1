# Keep this service separate from the MCP gateway. Never reuse Supabase signing
# secrets, MCP_INTERNAL_SECRET, or application database credentials for its keys.
NODE_ENV=production
HOST=0.0.0.0
PORT=8790
AUTH_ISSUER_URL=https://auth.redirx.dev
MCP_PUBLIC_URL=https://redirx-mcp-server.onrender.com/
SUPABASE_AUTH_ISSUER=https://bzpkrjnaatvohsipmupk.supabase.co/auth/v1
# Dedicated public client, exact callback https://auth.redirx.dev/upstream/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_ANON_KEY=
# Dedicated database role restricted to mcp_auth. Verified TLS is required remotely.
AUTH_DATABASE_URL=
# JSON arrays: active first, previous keys retained while their state expires.
AUTH_COOKIE_KEYS=[]
AUTH_STORAGE_KEYS=[]
# Private RSA JWK set, RS256, stable kid. Never generate a fresh key at startup.
AUTH_SIGNING_JWKS={"keys":[]}
# Only enable behind a trusted proxy that replaces forwarded headers.
AUTH_TRUST_PROXY=0
