# Copy to .env for local development: cp .env.example .env

# --- This server ---
PORT=8787
HOST=0.0.0.0
# The externally-reachable origin of THIS server. In production this MUST be
# the real HTTPS URL (Render assigns one, or use a custom domain) — it feeds
# both the OAuth Protected Resource Metadata `resource` field and the
# DNS-rebinding-protection allowed-hosts list.
MCP_PUBLIC_URL=http://localhost:8787
# OAuth tokens must have aud exactly new URL(MCP_PUBLIC_URL).href (here:
# http://localhost:8787/). Generic 'authenticated' audiences are rejected.
# Configure and test resource-bound provider issuance before deployment.
# Extra hostnames to accept on the Host header, comma-separated, bare
# hostnames only (no port, no scheme). MCP_PUBLIC_URL's own host is always
# allowed automatically.
# MCP_ALLOWED_HOSTS=

# --- The existing Flask backend this gateway wraps ---
REDIRX_BACKEND_URL=http://localhost:5001
# Shared secret for backend/routes/internal_routes.py's /api/internal/*
# routes. Must match that backend's MCP_INTERNAL_SECRET exactly. Generate
# with: openssl rand -hex 32
MCP_INTERNAL_SECRET=

# --- Auth ---
# 'oauth' (production, default) verifies bearer tokens against an external
# authorization server. 'dev' accepts a raw Redirx API key (rdx_...) as the
# bearer token instead — no OAuth handshake, no PRM — for local testing
# without a working Supabase OAuth Server. See src/auth/types.ts.
MCP_AUTH_MODE=oauth

# Required in oauth mode. Exact issuer for the selected provider. Direct Supabase
# DCR works but its observed generic audience fails the MCP resource gate; see
# docs/oauth-resource-gate-2026-09-19.md and mcp-auth-server/README.md.
# If discovery fails at boot, the server refuses to start rather than serve
# tools nobody can authenticate to.
OAUTH_ISSUER_URL=
# Set to broker only after the separate authorization service passes acceptance.
# Then OAUTH_ISSUER_URL is its exact origin (e.g. https://auth.redirx.dev),
# and SUPABASE_AUTH_ISSUER remains the existing identity authority.
MCP_OAUTH_PROVIDER=supabase
SUPABASE_AUTH_ISSUER=https://bzpkrjnaatvohsipmupk.supabase.co/auth/v1
# Required for MCP_OAUTH_PROVIDER=supabase. Calls Supabase's GET /auth/v1/user for
# token verification (same call the Flask backend's verify_token() makes).
SUPABASE_ANON_KEY=

# --- PostHog (@posthog/mcp) ---
# Point at the SAME PostHog project as frontend/.env's
# VITE_PUBLIC_POSTHOG_KEY — this is one more surface into an existing
# project, not a new one.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
